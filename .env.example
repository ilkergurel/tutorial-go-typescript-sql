# StackLab environment. Only .env.example is committed.
#
# Local mode (`npm start`, ADR-0008) needs none of this: every backend variable
# defaults to the local setup (one PostgreSQL on 127.0.0.1:5432, lessons run
# in-process). The backend reads its process environment only; nothing loads
# this file except Docker Compose, which uses it for the version variables.

# Backend HTTP listener. Docker mode sets 0.0.0.0 inside the container.
STACKLAB_HTTP_HOST=127.0.0.1
STACKLAB_HTTP_PORT=8080

# Postgres for the app's own data (Docker mode: host `app-db`).
STACKLAB_DATABASE_URL=postgres://stacklab:stacklab@127.0.0.1:5432/stacklab

# Unset = run lessons inside the backend (local mode). Docker mode sets
# http://runner:8090 to use the sandboxed runner container instead.
# STACKLAB_RUNNER_URL=

# Database SQL lessons run against: a NON-superuser role (scripts/setup-local-db.sql).
# Docker mode: host `playground-db`, read by the runner container.
STACKLAB_RUNNER_DATABASE_URL=postgres://playground:playground@127.0.0.1:5432/playground

# Logging: text (dev) or json.
STACKLAB_LOG_LEVEL=info
STACKLAB_LOG_FORMAT=text

# Tool versions used by docker compose (defaults shown; normally leave as-is).
# Bump PG_MAJOR to 19 after its GA (2026-11-19) — that's the whole bump.
PG_MAJOR=18
GO_VERSION=1.27.4
NODE_VERSION=22
