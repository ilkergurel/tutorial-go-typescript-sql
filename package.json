{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.app.json",
    "gen:curriculum": "node scripts/gen-curriculum.mjs",
    "prebuild": "node scripts/copy-wasm.mjs && node scripts/build-lesson-libs.mjs",
    "verify:lessons": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-lessons.mjs",
    "build:lesson-libs": "node scripts/build-lesson-libs.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.107.1",
    "esbuild-wasm": "^0.28.2",
    "lucide-react": "^0.446.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
